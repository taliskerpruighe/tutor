__pycache__/
*.pyc

# Raw authoring notes the finished articles are written from, not part of
# the published course.
content/_pipeline/

# tui/bin/ holds the shipped macOS binaries and IS committed deliberately:
# the repo tarball is what the reader downloads, and without these binaries
# in it, that download would be source code rather than a working reader.
#
# bin/tutor-host stays ignored: it's the local build-machine binary, rebuilt
# constantly, and no end user needs it.
bin/tutor-host
